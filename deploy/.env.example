# ---- email platform import API ----
EMAIL_API_URL=http://api:3020
EMAIL_API_SECRET=replace-with-platform-API_SECRET
EMAIL_LIST_ID=replace-with-scraped-list-uuid

# Docker network of the email platform (see: docker network ls)
EMAIL_NETWORK=email-automation_default

# ---- github auth ----
# Comma-separated PATs (classic or fine-grained with public-repo read).
# More tokens = higher combined rate limit; the scraper rotates between them.
STARGAZER_GITHUB_TOKENS=ghp_xxx,ghp_yyy,ghp_zzz

# ---- scrape tuning ----
REPOS_PER_RUN=1        # repos to scrape per daily run (queue advances by this)
MAX_STARS=0            # 0 = all stargazers of the repo; or cap, e.g. 2000
MAX_REPOS=1            # own repos scanned per user for a commit email
MAX_FORK_REPOS=1       # forked repos scanned per user for a commit email
CONCURRENCY=5          # parallel user-enrichment workers
REQUEST_DELAY_MS=150   # pause between GitHub API calls (gentle scraping)
USE_SEARCH_API=false   # last-resort commit-search lookup (separate rate limit)
PUSH_NOREPLY=false     # include *@users.noreply.github.com (non-deliverable)

# ---- schedule ----
TZ=UTC                 # timezone for SCRAPE_AT
SCRAPE_AT=03:00        # daily run time "HH:MM"; empty disables the scheduler
RUN_ON_START=false     # run once immediately on container start (handy to test)

# ---- http ----
STARGAZER_ADDR=:8080
